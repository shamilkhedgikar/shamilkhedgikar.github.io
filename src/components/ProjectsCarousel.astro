---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { slugify } from '../utils/slugify';

type ProjectsCollectionEntry = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
type ProjectLink = NonNullable<ProjectsCollectionEntry['data']['links']>[number];
type ProjectTechnology = NonNullable<ProjectsCollectionEntry['data']['technologies']>[number];
type ProjectMediaItem = {
  image: ImageMetadata;
  alt: string;
};
type ProjectCard = Omit<
  ProjectsCollectionEntry['data'],
  'image' | 'imageAlt' | 'links' | 'technologies'
> & {
  id: string;
  image?: ImageMetadata;
  imageAlt?: string;
  media: ProjectMediaItem[];
  links?: ProjectLink[];
  technologies?: ProjectTechnology[];
  techSlugs: string[];
  Content?: any;
};

const imageModules = import.meta.glob<ImageMetadata>(
  '../content/projects/**/*.{png,jpg,jpeg,webp,avif,gif}',
  {
    eager: true,
    import: 'default',
  },
);

const projects: ProjectCard[] = await Promise.all(
  (await getCollection('projects'))
    .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
    .map(async (entry) => {
      const { Content } = await entry.render();
      const { image: rawImage, imageAlt: rawImageAlt, links, technologies, ...rest } = entry.data;

      const collectMediaSources = (input: unknown): Array<string | ImageMetadata> => {
        const results: Array<string | ImageMetadata> = [];
        const visit = (value: unknown) => {
          if (value == null) return;
          if (Array.isArray(value)) {
            value.forEach(visit);
            return;
          }
          if (typeof value === 'string') {
            value
              .split(',')
              .map((segment) => segment.trim())
              .filter(Boolean)
              .forEach((segment) => results.push(segment));
            return;
          }
          if (typeof value === 'object' && 'src' in (value as Record<string, unknown>)) {
            results.push(value as ImageMetadata);
          }
        };
        visit(input);
        return results;
      };

      const collectAltTexts = (input: unknown): string[] => {
        const results: string[] = [];
        const visit = (value: unknown) => {
          if (value == null) return;
          if (Array.isArray(value)) {
            value.forEach(visit);
            return;
          }
          if (typeof value === 'string') {
            value
              .split(',')
              .map((segment) => segment.trim())
              .filter(Boolean)
              .forEach((segment) => results.push(segment));
          }
        };
        visit(input);
        return results;
      };

      const imageValues = collectMediaSources(rawImage);
      const altValues = collectAltTexts(rawImageAlt);

      const resolveImage = (value: unknown): ImageMetadata | undefined => {
        if (!value) return undefined;
        if (typeof value === 'string') {
          const normalized = value.startsWith('./') ? value.slice(2) : value.replace(/^\/+/, '');
          if (!normalized) return undefined;
          const directPath = `../content/projects/${normalized}`;
          const slugPath =
            entry.slug && normalized
              ? `../content/projects/${entry.slug}/${normalized}`
              : undefined;
          return imageModules[directPath] ?? (slugPath ? imageModules[slugPath] : undefined);
        }
        if (typeof value === 'object' && value && 'src' in value) {
          return value as ImageMetadata;
        }
        return undefined;
      };

      const media =
        imageValues
          .map((value, index) => {
            const image = resolveImage(value);
            if (!image) return null;
            const fallbackAlt =
              (typeof rest.title === 'string' && rest.title) || entry.slug || 'Project media';
            const candidateAlt = altValues[index] ?? altValues[0] ?? fallbackAlt;
            const alt = candidateAlt.trim().length > 0 ? candidateAlt.trim() : fallbackAlt;
            return { image, alt } as ProjectMediaItem;
          })
          .filter(Boolean) ?? [];

      const image = media[0]?.image;
      const imageAlt = media[0]?.alt;

      const normalisedLinks =
        links?.map((link) => {
          const trimmed = link.label?.trim();
          if (trimmed) return { ...link, label: trimmed };
          try {
            const hostname = new URL(link.href).hostname.replace(/^www\./, '');
            return { ...link, label: hostname };
          } catch {
            return { ...link, label: link.href };
          }
        }) ?? [];

      const techSlugs =
        technologies?.map((tech) => slugify(tech.language)).filter(Boolean) ?? [];

      return {
        id: entry.id,
        ...rest,
        image,
        imageAlt,
        media,
        links: normalisedLinks,
        technologies,
        Content,
        techSlugs,
      } as ProjectCard;
    }),
);
---

<div class="projects-carousel" data-carousel>
  <button class="carousel-arrow is-prev arrow-pill" type="button" aria-label="Previous projects" data-dir="-1"></button>
  <div class="projects-track" data-track>
    {projects.map((project) => (
      <article
        class="project-card glass-card"
        data-card
        data-card-id={project.id}
        data-tech={project.techSlugs.join(' ')}
        tabindex="0"
        role="button"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <header class="project-card__header">
          <h3 class="project-card__title">{project.title}</h3>
          {project.year && <span class="project-card__year">{project.year}</span>}
        </header>
        <p class="project-card__summary">{project.summary}</p>
        {project.media.length > 0 && (
          <figure class="project-card__media" data-media>
            <div class="project-card__media-track" data-media-track>
              {project.media.map((item, index) => (
                <div
                  class="project-card__media-slide"
                  data-media-slide
                  data-active={index === 0 ? 'true' : 'false'}
                >
                  <Image
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                    class="project-card__media-img"
                  />
                </div>
              ))}
            </div>
            {project.media.length > 1 && (
              <div class="project-card__media-dots" data-media-dots role="tablist">
                {project.media.map((item, index) => (
                  <button
                    type="button"
                    class="project-card__media-dot"
                    data-media-dot
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-label={`Show image ${index + 1} of ${project.media.length}`}
                  ></button>
                ))}
              </div>
            )}
          </figure>
        )}
        {project.technologies && project.technologies.length > 0 && (
          <ul class="project-card__tags">
            {project.technologies.map((tech) => (
              <li>{tech.language}</li>
            ))}
          </ul>
        )}
        <div class="project-card__cta">
          <a
            class="project-card__link"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            data-primary-link
          >
            Explore
            <span aria-hidden="true" class="project-card__arrow">&#128279;</span>
          </a>
          {project.links && project.links.length > 0 && (
            <div class="project-card__links" aria-label="Supplementary links">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  class="project-card__link-line"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.icon && <Icon name={link.icon} size={16} class="project-link__icon" />}
                  {/* <span>{link.label}</span> */}
                </a>
              ))}
            </div>
          )}
        </div>
        <div class="project-card__body" data-project-body aria-hidden="true">
          {project.technologies && project.technologies.length > 0 && (
            <div class="project-tech-breakdown">
              {project.technologies.map((tech) => (
                <div class="project-tech-breakdown__item">
                  <h4>{tech.language}</h4>
                  {tech.tools && tech.tools.length > 0 && <p>{tech.tools.join(', ')}</p>}
                </div>
              ))}
            </div>
          )}
          <div class="project-card__details">
            <project.Content />
          </div>
        </div>
      </article>
    ))}
  </div>
  <button class="carousel-arrow is-next arrow-pill" type="button" aria-label="Next projects" data-dir="1"></button>
  <div class="project-overlay" data-project-overlay hidden aria-hidden="true">
    <div class="project-overlay__backdrop" data-overlay-backdrop></div>
    <div class="project-overlay__shell" role="dialog" aria-modal="true">
      <button
        class="project-overlay__close"
        type="button"
        aria-label="Close project details"
        data-overlay-close
      >
        &#10006;
      </button>
      <div class="project-overlay__content" data-overlay-content></div>
    </div>
  </div>
</div>

<style>
.projects-carousel{
  position: relative;
  width: 100%;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 1.2rem;
}

.projects-track{
  --carousel-card-size: clamp(320px, 44vw, 520px);
  position: relative;
  display: flex;
  gap: 1.5rem;
  align-items: stretch;
  padding-block: 1rem 1.5rem;
  padding-inline: 0;
  overflow-x: auto;
  overflow-y: visible;
  scroll-snap-type: x mandatory;
  overscroll-behavior-inline: contain;
  scrollbar-gutter: stable;
  mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.95) 4%, rgba(0, 0, 0, 0.95) 96%, rgba(0, 0, 0, 0) 100%);
  -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.95) 4%, rgba(0, 0, 0, 0.95) 96%, rgba(0, 0, 0, 0) 100%);
  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
}

.projects-track::-webkit-scrollbar{
  height: 8px;
}

.projects-track::-webkit-scrollbar-thumb{
  background: rgba(224, 231, 248, 0.5);
  border-radius: 999px;
}

.glass-card{
  border-radius: 16px;
  border: 1px solid rgba(224, 231, 248, 0.48);
  background: rgba(224, 231, 248, 0.42);
  backdrop-filter: blur(12px) saturate(140%);
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  box-shadow: 0 18px 24px rgba(15, 23, 42, 0.12);
}

.project-card{
  position: relative;
  display: grid;
  grid-auto-rows: max-content;
  gap: 1.1rem;
  padding: 1.85rem 2rem;
  scroll-snap-align: center;
  flex: 0 0 var(--carousel-card-size);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  cursor: pointer;
}

.project-card:focus-visible{
  outline: 2px solid rgba(15, 23, 42, 0.4);
  outline-offset: 3px;
}

.project-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.project-card__title{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: clamp(1.3rem, 2vw, 1.55rem);
  color: rgba(15, 23, 42, 0.94);
}

.project-card__year{
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.32rem 0.7rem;
  border-radius: 999px;
  border: 1px solid rgba(15, 23, 42, 0.1);
  background: rgba(255, 255, 255, 0.7);
  font-family: 'Golos Text', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(15, 23, 42, 0.65);
}

.project-card__summary{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.96rem;
  line-height: 1.55;
  color: rgba(15, 23, 42, 0.78);
}

.project-card__media{
  margin: 0;
  display: grid;
  gap: 0.5rem;
}

.project-card__media-track{
  position: relative;
  border-radius: 14px;
  overflow: hidden;
  background: rgba(15, 23, 42, 0.08);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
}

.project-card__media-slide{
  display: none;
}

.project-card__media-slide[data-active="true"]{
  display: block;
}

.project-card__media-slide :where(picture){
  display: block;
}

.project-card__media-slide :where(img){
  display: block;
  width: 100%;
  height: auto;
  object-fit: cover;
}

.project-card__media-dots{
  display: none;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
}

.project-card__media-dot{
  inline-size: 10px;
  block-size: 10px;
  border-radius: 50%;
  border: none;
  background: rgba(15, 23, 42, 0.2);
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;
  opacity: 0.7;
}

.project-card__media-dot:hover,
.project-card__media-dot:focus-visible{
  opacity: 1;
}

.project-card__media-dot:focus-visible{
  outline: 2px solid rgba(15, 23, 42, 0.65);
  outline-offset: 3px;
}

.project-card__media-dot[aria-selected="true"]{
  transform: scale(1.28);
  background: rgba(15, 23, 42, 0.85);
  opacity: 1;
}

.project-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0;
  padding: 1rem 0 0;
  list-style: none;
  border-top: 1px solid rgba(15, 23, 42, 0.12);
}

.project-card__tags li{
  font-family: 'Golos Text', sans-serif;
  font-size: 0.74rem;
  font-weight: 600;
  padding: 0.24rem 0.55rem;
  border-radius: 999px;
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.55);
  color: rgba(15, 23, 42, 0.74);
  letter-spacing: 0.01em;
}

.project-card__cta{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
}

.project-card__link{
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: 0.9rem;
  color: #0f172a;
  text-decoration: none;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  border: 1px solid rgba(15, 23, 42, 0.12);
  background: rgba(255, 255, 255, 0.65);
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.project-card__link:hover{
  transform: translateY(-2px);
  box-shadow: 0 12px 20px rgba(15, 23, 42, 0.16);
  background: rgba(255, 255, 255, 0.9);
}

.project-card__links{
  display: flex;
  align-items: center;
  gap: 1.35rem;
}

.project-card__link-line{
  display: inline-flex;
  inline-size: 32px;
  block-size: 32px;
  border-radius: 50%;
  border: none;
  background: none;
  color: rgba(15, 23, 42, 0.78);
  text-decoration: none;
  transition: transform 0.18s ease;
}

.project-card__link-line:hover{
  transform: translateY(-1px);
}

.project-link__icon{
  display: inline-flex;
  color: inherit;
}

.project-card__body{
  display: grid;
  gap: 1rem;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-0.3rem);
  transition: max-height 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.35s ease, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.project-card__body :where(p, ul){
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.95rem;
  line-height: 1.58;
  color: rgba(15, 23, 42, 0.85);
}

.project-card__body :where(p + *, ul + *){
  margin-top: 0.85rem;
  border-top: 1px solid rgba(15, 23, 42, 0.12);

}

.project-card__body :where(a){
  color: inherit;
  font-weight: 600;
  text-decoration: underline;
}

.project-tech-breakdown{
  display: grid;
  gap: 0.85rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(15, 23, 42, 0.12);
}

.project-card__details{
  padding-top: 1rem;
  border-top: 1px solid rgba(15, 23, 42, 0.12);
}

.project-tech-breakdown__item{
  display: grid;
  gap: 0.35rem;
}

.project-tech-breakdown__item h4{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  color: rgba(15, 23, 42, 0.84);
}

.project-tech-breakdown__item p{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.85rem;
  color: rgba(15, 23, 42, 0.7);
}

.project-overlay{
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: clamp(1.25rem, 3vw, 2.5rem);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.24s ease;
  z-index: 1200;
}

.project-overlay.is-open{
  opacity: 1;
  pointer-events: auto;
}

.project-overlay__backdrop{
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.34);
  backdrop-filter: blur(6px) saturate(120%);
  -webkit-backdrop-filter: blur(6px) saturate(120%);
  opacity: 0;
  transition: opacity 0.24s ease;
}

.project-overlay.is-open .project-overlay__backdrop{
  opacity: 1;
}

.project-overlay__close{
  position: absolute;
  top: clamp(0.4rem, 1.2vw, 0.75rem);
  right: clamp(0.4rem, 1.2vw, 0.75rem);
  inline-size: 32px;
  block-size: 32px;
  border: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  color: rgba(15, 23, 42, 0.85);
  font-size: 1.1rem;
  font-weight: 600;
  display: grid;
  place-items: center;
  cursor: pointer;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.project-overlay__close:hover{
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 10px 16px rgba(15, 23, 42, 0.18);
}

.project-overlay__close:focus-visible{
  outline: 2px solid rgba(15, 23, 42, 0.6);
  outline-offset: 2px;
}

.project-overlay__shell{
  position: relative;
  width: min(96vw, 1120px);
  max-width: 720px;
  max-height: min(92vh, 960px);
  overflow-y: auto;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  border-radius: 20px;
  transform: translateY(18px) scale(0.94);
  transition: transform 0.36s cubic-bezier(0.2, 0.75, 0.2, 1);
}

.project-overlay__shell::-webkit-scrollbar{
  display: none;
}

.project-overlay.is-open .project-overlay__shell{
  transform: translateY(0) scale(1);
}

.project-overlay__content{
  padding: clamp(0.75rem, 1.2vw, 1.4rem);
}

.project-card--overlay{
  cursor: default;
  box-shadow: none;
  padding: clamp(1.6rem, 2.6vw, 2rem);
  gap: 1.25rem;
  margin-inline: auto;
  background: rgba(224, 231, 248, 0.9);
  border: 1px solid rgba(224, 231, 248, 0.55);
  backdrop-filter: none;
}

.project-card--overlay .project-card__body{
  max-height: none;
  opacity: 1;
  transform: none;
}

.project-card--overlay .project-card__media{
  gap: 0.75rem;
}

.project-card--overlay .project-card__media-track{
  border-radius: 16px;
}

.project-card--overlay .project-card__media-dots{
  display: inline-flex;
}

.project-card--overlay .project-card__media-dot{
  inline-size: 11px;
  block-size: 11px;
}

.project-card--overlay .project-card__cta{
  flex-wrap: wrap;
}

.carousel-arrow{
  position: relative;
  display: grid;
  place-items: center;
  inline-size: 48px;
  block-size: 48px;
  border-radius: 50%;
  border: 1px solid rgba(224, 231, 248, 0.48);
  background: rgba(224, 231, 248, 0.4);
  backdrop-filter: blur(12px) saturate(140%);
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  box-shadow: 0 12px 20px rgba(15, 23, 42, 0.18);
  color: #0f172a;
  font-family: 'Golos Text', sans-serif;
  font-weight: 700;
  font-size: 1.6rem;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease, background 0.2s ease;
}

.carousel-arrow:hover{
  transform: translateY(-2px);
  box-shadow: 0 16px 24px rgba(15, 23, 42, 0.2);
  background: rgba(224, 231, 248, 0.6);
}

.carousel-arrow:disabled{
  opacity: 0.35;
  cursor: default;
  pointer-events: none;
}

.carousel-arrow::before{
  content: '\23F5';
  display: grid;
  place-items: center;
  transform: translateY(-1px);
}

.carousel-arrow[data-dir="-1"]::before{
  content: '\23F4';
}

.carousel-arrow:focus-visible{
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.arrow-pill{
  border-radius: 999px;
  border-width: 1.5px;
}

@media (max-width: 960px){
  .projects-carousel{
    grid-template-columns: 1fr;
  }

  .projects-track{
    gap: 1rem;
    padding-inline: clamp(0.4rem, 3vw, 1rem);
  }
}

@media (max-width: 720px){
  .projects-track{
    --carousel-card-size: calc(100% - 1rem);
    mask-image: none;
    -webkit-mask-image: none;
  }

  .project-card{
    padding: 1.7rem 1.8rem;
  }

  .project-overlay__shell{
    width: min(96vw, 640px);
  }
}
</style>












