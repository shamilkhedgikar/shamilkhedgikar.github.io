---
import { getCollection } from 'astro:content';

const normalizeImage = (value: unknown) => {
  if (!value) return null;
  if (typeof value === 'string') {
    return { src: value, alt: '' };
  }
  if (typeof value === 'object' && value !== null && 'src' in value) {
    const record = value as { src?: string; alt?: string };
    if (typeof record.src === 'string') {
      return {
        src: record.src,
        alt: typeof record.alt === 'string' ? record.alt : '',
      };
    }
  }
  return null;
};

const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0))
  .map((item) => ({
    ...item.data,
    id: item.id,
    image: normalizeImage((item.data as Record<string, unknown>).image),
  }));
---

<div class="projects-carousel" data-carousel>
  <button class="carousel-arrow is-prev arrow-pill" type="button" aria-label="Previous projects" data-dir="-1"></button>
  <div class="projects-track" data-track>
    {projects.map((project) => (
      <article class="project-card glass-card" data-card>
        <header class="project-card__header">
          <h3>{project.title}</h3>
        </header>
        <p class="project-card__summary">{project.summary}</p>
        {project.image && (
          <figure class="project-card__media">
            <img src={project.image.src} alt={project.image.alt} loading="lazy" />
          </figure>
        )}
        <ul class="project-card__tags">
          {project.stack.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <a class="project-card__link" href={project.href} target="_blank" rel="noopener noreferrer">
          Explore
          <span aria-hidden="true" class="project-card__arrow">→</span>
        </a>
      </article>
    ))}
  </div>
  <button class="carousel-arrow is-next arrow-pill" type="button" aria-label="Next projects" data-dir="1"></button>
</div>

<style>
.projects-carousel{
  position: relative;
  width: 100%;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: stretch;
  gap: 1.2rem;
}

.projects-track{
  position: relative;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(400px, 600px);
  min-height: 480px;
  align-items: stretch;
  gap: 2rem;
  padding-block: 0.5rem;
  padding-inline: 0;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  overscroll-behavior-inline: contain;
  scrollbar-gutter: stable;
  mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.95) 4%, rgba(0, 0, 0, 0.95) 96%, rgba(0, 0, 0, 0) 100%);
  -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.95) 4%, rgba(0, 0, 0, 0.95) 96%, rgba(0, 0, 0, 0) 100%);
  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
}

.projects-track::selection{
  background: rgba(15, 23, 42, 0.1);
}

.projects-track::-webkit-scrollbar{
  height: 8px;
}

.projects-track::-webkit-scrollbar-thumb{
  background: rgba(224, 231, 248, 0.5);
  border-radius: 999px;
}

.glass-card{
  border-radius: 16px;
  border: 1px solid rgba(224, 231, 248, 0.48);
  background: rgba(224, 231, 248, 0.42);
  backdrop-filter: blur(12px) saturate(140%);
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  box-shadow: 0 18px 24px rgba(15, 23, 42, 0.12);
}

.project-card{
  display: grid;
  grid-auto-rows: max-content;
  gap: 1.35rem;
  padding: 2.4rem 2.5rem;
  scroll-snap-align: center;
  min-block-size: 100%;
  height: 100%;
}

.project-card__header h3{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: 1.45rem;
  text-align: left;
}

.project-card__summary{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 1.02rem;
  line-height: 1.65;
  text-align: left;
  color: rgba(15, 23, 42, 0.78);
}

.project-card__media{
  margin: 0;
  border-radius: 14px;
  overflow: hidden;
  background: rgba(15, 23, 42, 0.08);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
}

.project-card__media img{
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.project-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.project-card__tags li{
  font-family: 'Golos Text', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  border: 1px solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.55);
  color: rgba(15, 23, 42, 0.75);
  letter-spacing: 0.01em;
}

.project-card__link{
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  align-self: flex-start;
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: 0.9rem;
  color: #0f172a;
  text-decoration: none;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  border: 1px solid rgba(15, 23, 42, 0.12);
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  background: rgba(255, 255, 255, 0.65);
}

.project-card__link:hover{
  transform: translateY(-2px);
  box-shadow: 0 10px 18px rgba(15, 23, 42, 0.12);
  background: rgba(255, 255, 255, 0.9);
}

.project-card__arrow{
  font-weight: 700;
}

.carousel-arrow{
  position: relative;
  display: grid;
  place-items: center;
  inline-size: 48px;
  block-size: 48px;
  align-self: center;
  border-radius: 50%;
  border: 1px solid rgba(224, 231, 248, 0.48);
  background: rgba(224, 231, 248, 0.4);
  backdrop-filter: blur(12px) saturate(140%);
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  box-shadow: 0 12px 20px rgba(15, 23, 42, 0.18);
  color: #0f172a;
  font-family: 'Golos Text', sans-serif;
  font-weight: 700;
  font-size: 1.6rem;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.carousel-arrow:hover{
  transform: translateY(-2px);
  box-shadow: 0 16px 24px rgba(15, 23, 42, 0.2);
}

.carousel-arrow::before{
  content: '\23F5';
  display: grid;
  place-items: center;
  transform: translateY(-1px);
}

.carousel-arrow[data-dir="-1"]::before{
  content: '\23F4';
}

.carousel-arrow:focus-visible{
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.arrow-pill{
  border-radius: 999px;
  border-width: 1.5px;
}

@media (max-width: 720px){
  .projects-carousel{
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .projects-track{
    grid-auto-columns: minmax(80vw, 1fr);
    padding-inline: 0.5rem;
    mask-image: none;
    -webkit-mask-image: none;
  }

  .carousel-arrow{
    justify-self: center;
  }
}
</style>

