---
import github from "../assets/icons/github-tritone-fixed.svg?raw";
import scholar from "../assets/icons/googlescholarNew.svg?raw";
import instagram from "../assets/icons/insta-dark-tritone.svg?raw";
import linkedin from "../assets/icons/linkedin-tritone-fixed.svg?raw";
import twitter from "../assets/icons/twitter-dark-tritone.svg?raw";
import rss from "../assets/icons/rss-rounded-tritone.svg?raw";
import pdf from "../assets/icons/pdf-icon.svg?raw";
import hyperlink from "../assets/icons/hyperlink.svg?raw";
import blog from "../assets/icons/blog-link.svg?raw";
import youtube from "../assets/icons/youtube-icon.svg?raw";
import knowledgeGraph from "../assets/icons/knowledge-graph.svg?raw";

const { name, size = 24, class: extra = '' } = Astro.props as {
  name:
    | 'github'
    | 'scholar'
    | 'instagram'
    | 'linkedin'
    | 'twitter'
    | 'rss'
    | 'pdf'
    | 'hyperlink'
    | 'blog'
    | 'youtube'
    | 'knowledge-graph';
  size?: number;
  class?: string;
};
const registry = {
  github,
  scholar,
  instagram,
  linkedin,
  twitter,
  rss,
  pdf,
  hyperlink,
  blog,
  youtube,
  "knowledge-graph": knowledgeGraph,
} as const;
const rawSvg = registry[name];
if (!rawSvg) throw new Error(`Unknown icon: ${name}`);

// Avoid duplicated paint-server ids like "tritone" across multiple inline SVGs.
const uniquePaintId = `tritone-${name}-${Math.random().toString(36).slice(2, 10)}`;
const svg = rawSvg
  .replace(/id=(['"])tritone\1/g, `id="${uniquePaintId}"`)
  .replace(/url\(#tritone\)/g, `url(#${uniquePaintId})`);
---

<span class={`icon ${extra}`} style={`inline-size:${size}px; block-size:${size}px`} set:html={svg} />

<style>
.icon :where(svg){ width:100%; height:100%; display:block; }
.icon :where(path, circle, rect, polygon):not([fill^="url("]){ fill: currentColor; }
</style>
