---
// No need to import rough
---
<div id="rough-background" class="rough-bg-layer">
  <div id="svg-container" class="ink-overlay fixed-background"></div>
</div>

<style>
.ink-overlay.fixed-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: transparent;
  background-repeat: repeat;
  overflow: visible;
  background-position: center center;
  z-index: -1;
  pointer-events: none;
}

.rough-bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -2;
  pointer-events: none;
  overflow: hidden;
  will-change: transform;
}

</style>

<!-- Load rough.js and your custom script -->
<script src="https://cdn.jsdelivr.net/npm/roughjs@4.5.1/bundled/rough.min.js" defer></script>
<script type="module" src="/js/rough-sketch.js"></script>