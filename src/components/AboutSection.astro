---
const { id = 'about', heading = '' } = Astro.props;
---

<section
  id={id}
  class="scroll-section about-section"
  aria-labelledby={heading ? `${id}-heading` : undefined}
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class="about-shell">
    {heading && (
      <div class="about-head">
        <h2 id={`${id}-heading`} class="about-title">{heading}</h2>
      </div>
    )}
    <div class="about-collapsible" data-collapsible>
      <div id={`${id}-body`} class="about-body" itemprop="description">
        <div class="about-copy">
          <div class="md">
            <slot name="bio" />
          </div>
        </div>
      </div>
      <nav class="down-nav">
        <button
          class="about-toggle"
          type="button"
          aria-controls={`${id}-body`}
          aria-expanded="false"
        >▼</button>
      </nav>
    </div>
  </div>
</section>

<style>
.about-section{
  padding-block: clamp(2rem, 4vw, 3rem);
  scroll-margin-top: 7.5rem;
}

.about-shell{
  width: min(100%, 900px);
  margin: 0 auto;
  display: grid;
  gap: 1.35rem;
  text-align: left;
}

.about-head{
  display: grid;
  gap: clamp(0.4rem, 0.9vw, 0.65rem);
}

.about-title{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: clamp(1.6rem, 3vw, 2rem);
}

.about-body{
  position: relative;
  max-block-size: var(--teaser, 190px);
  overflow: hidden;
  transition: max-block-size 0.32s ease;
}

.about-copy{
  font-family: 'Golos Text', sans-serif;
  font-size: 1rem;
  line-height: 1.00;
  color: rgba(15, 23, 42, 0.78);
  text-align:left;
  max-width: 86ch;
}

.about-body::after{
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  block-size: 120px;
  /* background: linear-gradient(180deg, rgba(224, 231, 248, 0) 0%, rgba(224, 231, 248, 0.82) 55%, rgba(224, 231, 248, 1) 100%); */
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.about-copy .md :where(p){
  margin: 0 0 0.9rem 0;
  line-height: 1.65;
}

.about-copy .md :where(h2,h3){
  margin: 1.2rem 0 0.4rem;
}

.about-copy .md :where(ul,ol){
  margin: 0.6rem 0 0.9rem 1.2rem;
}

.about-copy .md :where(a){
  text-decoration: underline;
}

.about-collapsible[data-expanded] .about-body{
  max-block-size: 160rem;
}

.about-collapsible[data-expanded] .about-body::after{
  opacity: 0;
}

.about-collapsible{
  position: relative;
  padding-bottom: 2.25rem;
}

.down-nav{
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translate(-50%, 40%);
}

.about-toggle{
  --about-rotate: 0deg;
  display: grid;
  place-items: center;
  font-family: 'Golos Text', sans-serif;
  font-weight: 700;
  border: 1px solid rgba(224, 231, 248, 0.5);
  background: rgba(224, 231, 248, 0.48);
  -webkit-backdrop-filter: blur(12px) saturate(130%);
  backdrop-filter: blur(12px) saturate(130%);
  color: rgba(15, 23, 42, 0.78);
  padding: 0.2rem 0.9rem;
  border-radius: 8px;
  font-size: 1.1rem;
  box-shadow: 0 8px 14px rgba(15, 23, 42, 0.12);
  opacity: 0.7;
  transition: transform 0.28s ease, opacity 0.5s ease, box-shadow 0.28s ease;
  pointer-events: auto;
  cursor: pointer;
  transform: translateY(0) rotate(var(--about-rotate));
}

.about-toggle:hover{
  transform: translateY(-2px) rotate(var(--about-rotate));
  opacity: 1;
  box-shadow: 0 12px 18px rgba(15, 23, 42, 0.18);
}

.about-collapsible[data-expanded] .about-toggle{
  --about-rotate: 180deg;
}

.about-toggle:focus-visible{
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

@media (max-width: 720px){
  .about-shell{
    gap: 1.15rem;
    padding-inline: 0.25rem;
  }

  .about-body{
    max-block-size: var(--teaser, 280px);
  }
}
</style>
