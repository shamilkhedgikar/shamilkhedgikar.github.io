---
import { skills } from '../data/skills';
import { slugify } from '../utils/slugify';

type SkillInput =
  | string
  | {
      language: string;
      tools?: readonly string[];
    };

type SkillProps = {
  items?: readonly SkillInput[];
  heading?: string;
};

const toGroups = (item: SkillInput) => {
  if (typeof item === 'string') {
    return item
      .split('|')
      .map((chunk) => chunk.trim())
      .filter(Boolean)
      .map((chunk) => {
        const match = chunk.match(/^(?<language>[^()]+?)(?:\((?<tools>.+)\))?$/);
        const language = match?.groups?.language?.trim() ?? chunk;
        const tools =
          match?.groups?.tools
            ?.split(',')
            .map((tool) => tool.trim())
            .filter(Boolean) ?? [];
        return { language, tools };
      });
  }

  const language = item.language?.trim() ?? '';
  const tools = Array.isArray(item.tools)
    ? item.tools.map((tool) => tool.trim()).filter(Boolean)
    : [];
  return language ? [{ language, tools }] : [];
};

const { items = skills, heading = 'Technologies' } = Astro.props as SkillProps;

const seen = new Set<string>();

const groups = items
  .flatMap(toGroups)
  .filter((group) => group.language.length > 0)
  .map((group) => {
    const slug = slugify(group.language);
    return { ...group, slug };
  })
  .filter((group) => {
    if (group.slug.length === 0) return false;
    if (seen.has(group.slug)) return false;
    seen.add(group.slug);
    return true;
  });
---

<article class="skills-card glass-card" data-tech-filter>
  <header class="skills-card__header">
    <h3>{heading}</h3>
  </header>
  <div class="tech-groups">
    {groups.map((group) => (
  <section class="tech-group">
    <button
      type="button"
      class="atlas-tag is-language"
      data-filter-value={group.slug}
      data-level="language"
      aria-pressed="false"
    >
      {group.language}
    </button>
    {group.tools.length > 0 && (
      <p class="tech-group__details">{group.tools.join(', ')}</p>
    )}
  </section>
))}
  </div>
</article>

<script is:inline>
  document.addEventListener('astro:load', () => {
    document.querySelectorAll('[data-tech-filter]').forEach((root) => {
      const selected = new Set();

      const dispatch = () => {
        window.dispatchEvent(
          new CustomEvent('tech-filter-change', {
            detail: { values: Array.from(selected) },
          }),
        );
      };

      const toggle = (button) => {
        const value = button?.dataset.filterValue;
        if (!value) return;
        const nextState = !button.classList.contains('is-active');
        button.classList.toggle('is-active', nextState);
        button.setAttribute('aria-pressed', String(nextState));
        if (nextState) {
          selected.add(value);
        } else {
          selected.delete(value);
        }
        dispatch();
      };

      const buttons = Array.from(
        root.querySelectorAll('button[data-filter-value][data-level="language"]'),
      );

      buttons.forEach((button) => {
        button.addEventListener('click', () => toggle(button));
        button.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggle(button);
          }
        });
      });

      root.addEventListener('tech-filter-reset', () => {
        selected.clear();
        buttons.forEach((button) => {
          button.classList.remove('is-active');
          button.setAttribute('aria-pressed', 'false');
        });
        dispatch();
      });
    });
  });
</script>

<style>
.glass-card{
  border-radius: 16px;
  border: 1px solid rgba(224, 231, 248, 0.32);
  background: rgba(224, 231, 248, 0.42);
  -webkit-backdrop-filter: blur(0px) saturate(140%);
  box-shadow: 0 18px 24px rgba(15, 23, 42, 0.1);
}

.skills-card{
  display: grid;
  gap: 1.25rem;
  padding: 1.7rem 1.9rem;
}

.skills-card__header{
  display: grid;
  gap: 0.35rem;
}

.skills-card__header h3{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 1.1rem;
  font-weight: 600;
  color: rgba(15, 23, 42, 0.92);
}

.skills-card__hint{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.82rem;
  color: rgba(15, 23, 42, 0.6);
}

.tech-groups{
  display: ruby;
  ruby-position: over;
}

.tech-group{
  display: inline-grid;
  gap: 0.6rem;
  margin-inline-end: clamp(1.8rem, 3.2vw, 2.8rem);
  margin-block-end: 1.1rem;
}

.tech-group:last-child{
  margin-inline-end: 0;
}

.tech-group__details{
  margin: 0;
  font-family: 'Golos Text', sans-serif;
  font-size: 0.8rem;
  color: rgba(15, 23, 42, 0.58);
  line-height: 1.4;
  opacity: 0;
  max-height: 0;
  transform: translateY(0rem);
  transition: opacity 0.24s ease, max-height 0.1s ease, transform 0.24s ease;
  pointer-events: none;
}

.atlas-tag{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.55rem 2rem;
  border-radius: 12px;
  border: 1px solid rgba(15, 23, 42, 0.1);
  background: rgba(255, 255, 255, 0.65);
  font-family: 'Golos Text', sans-serif;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: rgba(15, 23, 42, 0.78);
  cursor: pointer;
  transition: transform 0.32s ease, box-shadow 0.32s ease, background 0.32s ease, border-color 0.32s ease;
}

.atlas-tag.is-language{
  background: rgba(224, 231, 248, 0.92);
  border-color: rgba(224, 231, 248, 0.92);
  padding: 0.45rem 1rem;
  box-shadow: -7px -2px 16px 1px rgba(15, 23, 42, 0.18)
}

.atlas-tag.is-active{
  background: rgba(224, 231, 248, 0.98);
  border-color: rgba(224, 231, 248, 1);
  color: rgba(15, 23, 42, 0.96);
  box-shadow: 0 22px 32px rgba(15, 23, 42, 0.22);
}

.atlas-tag:is(:hover, :focus-visible){
  transform: translateY(-1px);
  box-shadow: 0 10px 16px rgba(15, 23, 42, 0.16);
}

.atlas-tag:focus-visible{
  outline: 2px solid rgba(89, 102, 157, 0.6);
  outline-offset: 2px;
}

button.atlas-tag{
  background-color: transparent;
}

.tech-group:hover .atlas-tag.is-language,
.tech-group:focus-within .atlas-tag.is-language{
  background: rgba(224, 231, 248, 0.98);
  border-color: rgba(224, 231, 248, 1);
  color: rgba(15, 23, 42, 0.96);
  box-shadow: -6px 9px 16px 1px rgba(15, 23, 42, 0.18)
}

.tech-group:hover .tech-group__details,
.tech-group:focus-within .tech-group__details,
.atlas-tag.is-language.is-active + .tech-group__details{
  opacity: 1;
  max-height: 6rem;
  transform: translateY(0);
  pointer-events: auto;
}

@media (max-width: 720px){
  .skills-card{
    padding: 1.5rem 1.65rem;
  }
}
</style>
