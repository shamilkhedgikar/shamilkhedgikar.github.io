---
title: "Home"
import AboutSection from "../components/AboutSection.astro";
import { getEntry } from "astro:content";

//import Socials from "fulldev-ui/components/Socials.astro"
import SocialLink from '../components/SocialLink.astro';

const about = await getEntry("profile", "about");
const { Content } = await about.render();
const { title } = about.data;

---
<html lang="en">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400..900&family=Markazi+Text:wght@400..700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
  </head>
  <body style="text-align: center;">
    <div class="bg-image-layer" aria-hidden="true"></div>
    <div class="glass-ring">
      <img src="/profile-picture.jpg" alt="Profile Pic" class="profile-photo" />
    </div>
    <main>
      <header class="site-header" role="banner">
      <div class="brand">Shamil Shirish Khedgikar</div>
        <div class="socials small">
          <SocialLink name="linkedin" href="https://www.linkedin.com/in/shamilkhedgikar" label="LinkedIn" />
          <SocialLink name="github"   href="https://github.com/shamilkhedgikar" label="GitHub" />
          <SocialLink name="scholar"  href="https://scholar.google.com/citations?user=-u_uBZUAAAAJ&hl=en" label="Google Scholar" />
          <SocialLink name="twitter"  href="https://twitter.com/ShamilKhedgikar" label="Twitter" />
          <SocialLink name="instagram" href="https://www.instagram.com/swordsandblades/?hl=en" label="Instagram" />
        </div>
      </div>
      </header>
      <section class="hero">
        <header class="text-wrapper">
          <h1>Shamil Shirish Khedgikar</h1>
          <h4> Data Scientist . Product Engineer </h4>
        </header>
        <div class="socials">
          <SocialLink name="linkedin" href="https://www.linkedin.com/in/shamilkhedgikar" label="LinkedIn" />
          <SocialLink name="github"   href="https://github.com/shamilkhedgikar" label="GitHub" />
          <SocialLink name="scholar"  href="https://scholar.google.com/citations?user=-u_uBZUAAAAJ&hl=en" label="Google Scholar" />
          <SocialLink name="twitter"  href="https://twitter.com/ShamilKhedgikar" label="Twitter" />
          <SocialLink name="instagram" href="https://www.instagram.com/swordsandblades/?hl=en" label="Instagram" />
        </div>
        <div id="hero-sentinel" aria-hidden="true"></div>
      </section>
      <section id="about" class="scroll-section">
        <AboutSection id="about-md" heading= {title ?? ""}> 
          <Content slot="bio" />
        </AboutSection/>
      </section>
      <section id="projects" class="scroll-section">...</section>
      <section id="blog" class="scroll-section">...</section>
    </main> 
     
    <nav class="side-nav">
      <span class="nav-arrow">⏵</span>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="/#work-ex">Experience</a></li>
        <li><a href="#Projects">Projects</a></li>
        <li><a href="#Blog">Blog</a></li>
      </ul>
    </nav>
    <script src="https://cdn.jsdelivr.net/npm/marching-squares@1.0.0/dist/bundle.min.js"></script> 
    <script src="https://cdn.jsdelivr.net/npm/p5@1.9.0/lib/p5.min.js"></script>
    <!-- Load script *after* DOM elements -->
    <script>
      // Show the compact header when the hero is out of view
      const sentinel = document.getElementById('hero-sentinel');
      const io = new IntersectionObserver(([e]) => {
        if (e) {
          document.body.classList.toggle('show-header', !e.isIntersecting);
        }
      }, {threshold: 0.5});

      if (sentinel) io.observe(sentinel);
    </script>

  </body>
</html>

<style>
main {
  position: relative;
  isolation: isolate;
}

html, body {
  font-family: 'Marzaki Text', serif;
  font-weight: 300;
  font-size: 18px;
  background-size:auto;
  background-attachment:scroll;
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow-x: hidden; /* Prevent horizontal scroll */
}

html { scroll-behavior: smooth; }
#about, #projects, #blog { scroll-margin-top: 12px; } /* adjust if you add a fixed header */

.bg-image-layer {
  position: fixed;
  inset: 0;
  z-index: -7;                 /* behind your canvases (-5) */
  pointer-events: none;
  background-image: url('/textures/paper-texture.svg');
  background-size: auto;       /* or 'auto' if you like the tile */
  background-color:rgba(224, 231, 248, 0.482);
  background-attachment: scroll;
  will-change: transform;       /* perf */
}

.text-wrapper{
  position: relative;
  z-index: 2;
  font-family: 'Golos Text', sans-serif;
  font-weight: 300;
  font-size: 18px;
  transform: translateZ(0);
}

.text-wrapper h1 { margin: 0.5rem 0 0.25rem; }
.text-wrapper h4 { margin: 0.25rem 0 0; }

.scroll-section {
  min-block-size: 100vh;
  box-sizing: border-box;
  padding: 0rem 2rem;
  border-bottom: 1px dashed rgba(0,0,0,0.1);
  background-color: transparent;
  display: grid;
}

#about { scroll-margin-top: -15px; }

.side-nav {
  position: fixed;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  width: 40px;
  height: auto;
  overflow: hidden;
  background: rgba(224, 231, 248, 0.482)); /* base for glass */
  backdrop-filter: blur(8px);           /* glass blur */
  border-right: 2px solid rgba(224, 231, 248, 0.482));
  border-top-right-radius: 10px;
  border-bottom-right-radius: 10px;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
  transition: width 0.5s ease;
  z-index: 1000;
}

.side-nav:hover {
  width: 180px;
}

.side-nav ul {
  opacity: 0;
  list-style: none;
  transition: opacity 0.1s ease 0.2s;
  padding: 1rem;
  white-space: nowrap;
}

.side-nav li {
  margin: 1rem 0;
}

.side-nav a {
  display: block;
  font-family: 'Golos Text', sans-serif;
  font-size: 16px;
  text-decoration: none;
  fill-opacity: 0.8;
  color: #222;
  font-weight: 500;
  padding: 10px 16px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(8px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.15),
    0 0 20px rgba(0, 0, 0, 0.1);
  transition: background 0.2s ease, transform 0.2s ease;
}

.side-nav a:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateX(2px);
}

.nav-arrow {
  position: fixed;
  fill-opacity: 0.8;
  font-weight: 700;
  right: -6px;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px) saturate(150%);
  -webkit-backdrop-filter: blur(10px) saturate(150%);
  color: #000000;
  padding: 5px 5px;
  border-radius: 0 4px 4px 0;
  font-size: 1.6rem;
  box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.15),
    0 0 3px rgba(0, 0, 0, 0.15);
  border-left: 2px solid rgba(255, 255, 255, 0.3);
  border-top-left-radius: 6px;
  border-bottom-left-radius: 6px;
  pointer-events: none;
  opacity: 0.6;
  transition: opacity 0.5s ease;
}

.side-nav:hover .nav-arrow {
  opacity: 0;
}

.side-nav:hover ul {
  opacity: 1;
}

.side-nav .text-wrapper {
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  white-space: nowrap;
  padding: 0rem;
  opacity: 0.4;
}

.side-nav:hover .text-wrapper {
  transform: translateX(0);
  opacity: 0.2;
}

.site-header{
  position: fixed; inset: 0 0 auto 0; /* top:0; left/right:0 */
  display: flex; align-items: center; gap: .75rem;
  padding: .6rem 1rem;
  font-family: 'Golos Text', sans-serif;
  background: rgba(224, 231, 248, 0.482));
  -webkit-backdrop-filter: blur(10px) saturate(140%);
  backdrop-filter: blur(10px) saturate(140%);
  border-bottom: 1px solid rgba(224, 231, 248, 0.482));
  box-shadow: 0 30px 24px rgba(0,0,0,.08);
  transform: translateY(-100%);   /* slide out */
  opacity: 0;
  transition: transform .48s ease, opacity .28s ease;
  z-index: 1000;
}

.site-header .brand{
  font-family: 'Golos Text', sans-serif;
  font-weight: 600;
  font-size: 20px;
  margin-right: auto;            /* shove socials to the right */
}

.site-header .socials{
  display: flex; 
  gap: .4rem;
  scale: 0.7;
}

/* When scrolled past hero: show header */
body.show-header .site-header{
  transform: translateY(0);
  opacity: 1;
}

.profile-photo {
  position: relative;
  width: 99%;
  height: 99%;
  object-fit:fill;
  border-radius: 50%;
  opacity: 1;
}

.glass-ring {
  position: relative;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  padding: 0px;
  background: rgba(255, 255, 255, 0.8); /* translucent white */
  backdrop-filter: blur(2px);           /* blur effect */
  -webkit-backdrop-filter: blur(2px);   /* Safari support */
  box-shadow: 0px 20px 20px 20px rgba(0, 0, 0, .08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 2rem auto;
  border: 0.2px solid rgba(255, 255, 255, 0.3); /* subtle glass edge */
  z-index: 1;
  margin-bottom: 2rem;
}

/* SOCIALS: flex grid */
.socials {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;                /* row + column gap */
  justify-content: center;    /* or: flex-start */
}
</style>