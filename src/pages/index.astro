---
title: "Home"
import AboutSection from "../components/AboutSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import SkillsCard from "../components/SkillsCard.astro";
import { timelineCategories } from "../data/timelineCategories";
import { themeColors } from "../data/themeColors";
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import profilePic from "../assets/images/profile-picture.jpg";
import "@/styles/markdown.css";

import SocialLink from "../components/SocialLink.astro";

const aboutEntry = await getEntry("profile", "about");
if (!aboutEntry) {
  throw new Error('Missing content entry: profile/about. Create src/content/profile/about.md.');
}
const { Content } = await aboutEntry.render();
const aboutTitle = aboutEntry.data.title ?? "About";

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => {
    const orderDelta = (b.data.order ?? 0) - (a.data.order ?? 0);
    if (orderDelta !== 0) return orderDelta;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const formatBlogDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Golos+Text:wght@400..900&family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    >
    <title>Home</title>
  </head>
  <body>
    <div class="bg-image-layer" aria-hidden="true"></div>
    <div class="theme-switcher" role="group" aria-label="Background themes">
      <button type="button" class="theme-switcher__button theme-switcher__main is-active" data-theme="moon" title="Moon" aria-pressed="true">
        ⚪
      </button>
      <div class="theme-switcher__menu">
        <button type="button" class="theme-switcher__button" data-theme="charcoal" title="Charcoal" aria-pressed="false">
          ⬛
        </button>
        <button type="button" class="theme-switcher__button" data-theme="sand" title="Sand" aria-pressed="false">
          ⏳
        </button>
        <button type="button" class="theme-switcher__button" data-theme="bone" title="Bone" aria-pressed="false">
          🦴
        </button>
        <button type="button" class="theme-switcher__button" data-theme="moon" title="Moon" aria-pressed="false">
          ⚪
        </button>
      </div>
    </div>
    <div class="glass-ring">
      <Image src={profilePic} alt="Profile Pic" class="profile-photo" loading="eager" decoding="auto"/>
    </div>
    <main>
      <header class="site-header" role="banner">
        <div class="brand">
          <span class="brand__desktop">Shamil Shirish Khedgikar</span>
          <span class="brand__mobile">Shamil Shirish Khedgikar</span>
        </div>
        <div class="socials small site-header-socials">
          <SocialLink name="linkedin" href="https://www.linkedin.com/in/shamilkhedgikar" label="LinkedIn" />
          <SocialLink name="github" href="https://github.com/shamilkhedgikar" label="GitHub" />
          <SocialLink name="scholar" href="https://scholar.google.com/citations?user=-u_uBZUAAAAJ&hl=en" label="Google Scholar" />
          <SocialLink name="twitter" href="https://twitter.com/ShamilKhedgikar" label="Twitter" />
          <SocialLink name="instagram" href="https://www.instagram.com/swordsandblades/?hl=en" label="Instagram" />
          <SocialLink name="rss" href="/rss.xml" label="RSS Feed" />
        </div>
        <nav class="site-header-nav" aria-label="Top section navigation">
          <a href="#about">About</a>
          <a href="#experience">Work</a>
          <a href="#projects">Projects</a>
          <a href="#technologies">Tech</a>
          <a href="#blog">Blog</a>
          <button
            type="button"
            class="mobile-header-action"
            data-mobile-links-toggle
            aria-controls="mobile-links-panel"
            aria-expanded="false"
            aria-label="Open social links"
          >
            Links
          </button>
        </nav>
      </header>
      <aside id="mobile-links-panel" class="mobile-links-panel" data-mobile-links-panel hidden>
        <div class="mobile-links-panel__inner" role="group" aria-label="Social links">
          <SocialLink name="linkedin" href="https://www.linkedin.com/in/shamilkhedgikar" label="LinkedIn" />
          <SocialLink name="github" href="https://github.com/shamilkhedgikar" label="GitHub" />
          <SocialLink name="scholar" href="https://scholar.google.com/citations?user=-u_uBZUAAAAJ&hl=en" label="Google Scholar" />
          <SocialLink name="twitter" href="https://twitter.com/ShamilKhedgikar" label="Twitter" />
          <SocialLink name="instagram" href="https://www.instagram.com/swordsandblades/?hl=en" label="Instagram" />
          <SocialLink name="rss" href="/rss.xml" label="RSS Feed" />
        </div>
      </aside>

      <section class="hero">
        <header class="text-wrapper">
          <h1>Shamil Shirish Khedgikar</h1>
          <h4> Data Scientist &middot; Product Engineer </h4>
        </header>
        <div class="socials hero-socials">
          <SocialLink name="linkedin" href="https://www.linkedin.com/in/shamilkhedgikar" label="LinkedIn" />
          <SocialLink name="github" href="https://github.com/shamilkhedgikar" label="GitHub" />
          <SocialLink name="scholar" href="https://scholar.google.com/citations?user=-u_uBZUAAAAJ&hl=en" label="Google Scholar" />
          <SocialLink name="twitter" href="https://twitter.com/ShamilKhedgikar" label="Twitter" />
          <SocialLink name="instagram" href="https://www.instagram.com/swordsandblades/?hl=en" label="Instagram" />
          <SocialLink name="rss" href="/rss.xml" label="RSS Feed" />
        </div>
        <div id="hero-sentinel" aria-hidden="true"></div>
      </section>

      <AboutSection id="about" heading={aboutTitle}>
        <Content slot="bio" class="md" />
      </AboutSection>

      <section id="experience" class="scroll-section">
        <div class="section-shell">
          <div class="section-head">
            <h2 class="section-title">Experience</h2>
          </div>
          <div class="timeline-legend">
            {timelineCategories.map((category) => (
              <span class="timeline-legend__item">
                <span
                  class="timeline-legend__dot"
                  style={`background:${category.color}; box-shadow:0 0 0 5px ${category.halo};`}
                />
                {category.name}
              </span>
            ))}
          </div>
         <ExperienceTimeline />
        </div>
      </section>

      <section id="projects" class="scroll-section">
        <div class="section-shell">
          <div class="section-head">
            <h2 class="section-title">Projects</h2>
            <p class="section-subtitle">
              Selected works in engineering, data, and design.
            </p>
          </div>
          <ProjectsCarousel />
          <div id="technologies" class="tech-stack">
            <SkillsCard heading="Technologies" />
          </div>
        </div>
      </section>

      <section id="blog" class="scroll-section">
        <div class="section-shell">
          <div class="section-head">
            <h2 class="section-title">Blog</h2>
          </div>
          <div class="blog-grid">
            <article class="blog-card">
              <h3>Articles</h3>
              <p class="blog-card__intro">
                Curated long-form pieces unpacking projects and research.
              </p>
              {blogPosts.length > 0 ? (
                <ul class="blog-card__list">
                  {blogPosts.map((post) => {
                    const updated = post.data.updatedDate ?? post.data.pubDate;
                    return (
                      <li class="blog-card__item">
                        <a href={`/blog/${post.slug}`} class="blog-card__entry">
                          <span class="blog-card__entry-title">{post.data.title}</span>
                          <time datetime={updated.toISOString()}>{formatBlogDate(updated)}</time>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <p class="blog-card__empty">No posts just yet — check back soon.</p>
              )}
              <div class="blog-card__cta">
                <a href="/blog" class="blog-card__link">Browse</a>
                <a href="/rss.xml" class="blog-card__link is-secondary">Subscribe via RSS</a>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <nav class="side-nav" aria-label="Section quick navigation">
      <span class="nav-arrow" aria-hidden="true">&#x23F5;</span>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#experience">Work</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#technologies">Tech</a></li>
        <li><a href="#blog">Blog</a></li>
      </ul>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/marching-squares@1.0.0/dist/bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/p5@1.9.0/lib/p5.min.js"></script>

    <script is:inline define:vars={{ themeColors }}>
      (() => {
        const switcher = document.querySelector('.theme-switcher');
        if (!switcher) return;
        const themeButtons = Array.from(switcher.querySelectorAll('.theme-switcher__button'));
        if (themeButtons.length === 0) return;
        const mainButton = switcher.querySelector('.theme-switcher__main');
        const menuButtons = themeButtons.filter((button) => button !== mainButton);

        const buttonMeta = new Map();
        themeButtons.forEach((button) => {
          const theme = button.dataset.theme;
          if (!theme) return;
          const symbol = (button.textContent || '').trim();
          const title = button.getAttribute('title') || '';
          buttonMeta.set(theme, { symbol, title });
        });

        const THEME_COLORS = themeColors;

        let collapseHandler = null;
        const clearCollapseWatcher = () => {
          if (!collapseHandler) return;
          document.removeEventListener('pointermove', collapseHandler);
          document.removeEventListener('pointerdown', collapseHandler);
          collapseHandler = null;
        };

        const toggleExpanded = (on) => {
          if (on) {
            clearCollapseWatcher();
            switcher.classList.add('is-expanded');
          } else {
            clearCollapseWatcher();
            switcher.classList.remove('is-expanded');
          }
        };

        const scheduleCollapseWatcher = () => {
          if (collapseHandler) return;
          collapseHandler = (event) => {
            const target = event.target;
            if (target && switcher.contains(target)) return;
            toggleExpanded(false);
          };
          document.addEventListener('pointermove', collapseHandler);
          document.addEventListener('pointerdown', collapseHandler);
        };

        const updateMain = (theme) => {
          if (!(mainButton instanceof HTMLButtonElement)) return;
          const meta = buttonMeta.get(theme) ?? buttonMeta.get('moon');
          if (meta) {
            mainButton.textContent = meta.symbol;
            if (meta.title) {
              mainButton.setAttribute('title', meta.title);
            }
          }
          mainButton.dataset.theme = theme;
          mainButton.classList.add('is-active');
          mainButton.setAttribute('aria-pressed', 'true');
        };

        const setTheme = (theme, persist = true) => {
          if (theme === 'moon' || !(theme in THEME_COLORS)) {
            document.documentElement.style.removeProperty('--bg-layer-color');
          } else {
            document.documentElement.style.setProperty('--bg-layer-color', THEME_COLORS[theme]);
          }

          menuButtons.forEach((button) => {
            const isCurrent = button.dataset.theme === theme;
            button.classList.remove('is-active');
            button.setAttribute('aria-pressed', String(isCurrent));
          });

          updateMain(theme);
          clearCollapseWatcher();

          //collapse when i move away after selection without clicking outside
          switcher.classList.remove('is-expanded');
          scheduleCollapseWatcher();

          let __collapseTimer = window.setTimeout(() => {
            toggleExpanded(false);
            __collapseTimer = null;
          }, 200);

          // If the user re-enters (pointer or keyboard focus), cancel the timer
          const __cancelCollapse = () => {
            if (__collapseTimer) {
              clearTimeout(__collapseTimer);
              __collapseTimer = null;
            }
            switcher.removeEventListener('pointerenter', __cancelCollapse);
            switcher.removeEventListener('focusin', __cancelCollapse);
          };
          switcher.addEventListener('pointerenter', __cancelCollapse, { once: true });
          switcher.addEventListener('focusin', __cancelCollapse, { once: true });

          if (persist) {
            try {
              localStorage.setItem('bg-theme', theme);
            } catch (err) {
              /* ignore */
            }
          }
        };

        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem('bg-theme');
        } catch (err) {
          storedTheme = null;
        }
        const initialTheme =
          !storedTheme || (storedTheme !== 'moon' && !(storedTheme in THEME_COLORS))
            ? 'moon'
            : storedTheme;
        setTheme(initialTheme, false);

        themeButtons.forEach((button) => {
          const theme = button.dataset.theme ?? 'moon';
          button.addEventListener('click', () => {
            setTheme(theme);
          });
          button.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              setTheme(theme);
            }
          });
        });

        switcher.addEventListener('mouseenter', () => toggleExpanded(true));
        switcher.addEventListener('mouseleave', () => toggleExpanded(false));
        switcher.addEventListener('focusin', () => toggleExpanded(true));
        switcher.addEventListener('focusout', (event) => {
          if (!switcher.contains(event.relatedTarget)) {
            toggleExpanded(false);
          }
        });

        const mobileLinksToggle = document.querySelector('[data-mobile-links-toggle]');
        const mobileLinksPanel = document.querySelector('[data-mobile-links-panel]');
        const mobileLinksInner = mobileLinksPanel?.querySelector('.mobile-links-panel__inner');
        const heroName = document.querySelector('.text-wrapper h1');
        const heroSocials = document.querySelector('.hero-socials');
        const mobileViewportQuery = window.matchMedia('(max-width: 960px)');
        let mobileLinksOpen = false;

        const syncSocialsWidthToName = () => {
          if (!(heroName instanceof HTMLElement)) return;
          const measured = Math.ceil(heroName.getBoundingClientRect().width);
          if (!measured) return;
          const widthValue = `${measured}px`;
          if (heroSocials instanceof HTMLElement) {
            heroSocials.style.setProperty('--hero-name-width', widthValue);
          }
          if (mobileLinksInner instanceof HTMLElement) {
            mobileLinksInner.style.setProperty('--hero-name-width', widthValue);
          }
        };

        syncSocialsWidthToName();
        window.addEventListener('resize', syncSocialsWidthToName);
        window.addEventListener('orientationchange', syncSocialsWidthToName);
        if (document.fonts?.ready) {
          document.fonts.ready.then(syncSocialsWidthToName).catch(() => {});
        }

        const setMobileLinksOpen = (on) => {
          if (!(mobileLinksToggle instanceof HTMLButtonElement)) return;
          if (!(mobileLinksPanel instanceof HTMLElement)) return;
          const next = Boolean(on) && mobileViewportQuery.matches;
          mobileLinksOpen = next;
          mobileLinksToggle.setAttribute('aria-expanded', String(next));
          mobileLinksToggle.setAttribute('aria-label', next ? 'Close social links' : 'Open social links');
          if (next) {
            mobileLinksPanel.removeAttribute('hidden');
            requestAnimationFrame(() => {
              mobileLinksPanel.classList.add('is-open');
            });
            return;
          }
          mobileLinksPanel.classList.remove('is-open');
          window.setTimeout(() => {
            if (!mobileLinksOpen) {
              mobileLinksPanel.setAttribute('hidden', 'true');
            }
          }, 180);
        };

        const closeMobileLinks = () => setMobileLinksOpen(false);

        if (mobileLinksToggle instanceof HTMLButtonElement && mobileLinksPanel instanceof HTMLElement) {
          mobileLinksToggle.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            setMobileLinksOpen(!mobileLinksOpen);
          });

          document.addEventListener('pointerdown', (event) => {
            if (!mobileLinksOpen) return;
            const target = event.target;
            if (!(target instanceof Node)) return;
            if (mobileLinksPanel.contains(target) || mobileLinksToggle.contains(target)) return;
            closeMobileLinks();
          });

          mobileLinksPanel.addEventListener('click', (event) => {
            const target = event.target;
            if (target instanceof HTMLElement && target.closest('a')) {
              closeMobileLinks();
            }
          });

          window.addEventListener('resize', () => {
            if (!mobileViewportQuery.matches) {
              closeMobileLinks();
            }
          });
        }

        const sentinel = document.getElementById('hero-sentinel');
        if (sentinel) {
          const io = new IntersectionObserver(([entry]) => {
            if (!entry) return;
            document.body.classList.toggle('show-header', entry.intersectionRatio < 0.25);
          }, { threshold: [0, 0.25, 0.5, 1] });
          io.observe(sentinel);
        }

        const aboutSection = document.getElementById('about');
        const aboutCard = aboutSection?.querySelector('[data-collapsible]');
        const aboutToggle = aboutSection?.querySelector('.about-toggle');

        const isExpanded = () => !!aboutCard?.hasAttribute('data-expanded');

        const setAboutExpanded = (on) => {
          if (!aboutCard) return;
          if (on) {
            aboutCard.setAttribute('data-expanded', '');
            aboutToggle?.setAttribute('aria-expanded', 'true');
          } else {
            aboutCard.removeAttribute('data-expanded');
            aboutToggle?.setAttribute('aria-expanded', 'false');
          }
        };

        const toggleAbout = () => setAboutExpanded(!isExpanded());

        if (aboutToggle && aboutCard) {
          aboutToggle.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            toggleAbout();
          });
        }

        let expandedOnce = isExpanded();
        if (!expandedOnce) {
          const observer = new MutationObserver(() => {
            if (!expandedOnce && document.body.classList.contains('show-header')) {
              setAboutExpanded(true);
              expandedOnce = true;
              observer.disconnect();
            }
          });
          observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
        }

        const carousels = Array.from(document.querySelectorAll('[data-carousel]'));
        const activeFilters = new Set();

        const overlay = document.querySelector('[data-project-overlay]');
        const overlayContent = overlay?.querySelector('[data-overlay-content]');
        const overlayClose = overlay?.querySelector('[data-overlay-close]');
        const overlayBackdrop = overlay?.querySelector('[data-overlay-backdrop]');
        let activeCardId = null;
        let lastFocusedElement = null;
        const mediaInitialized = new WeakSet();
        const FOCUSABLE_SELECTOR =
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

        const isOverlayOpen = () =>
          overlay instanceof HTMLElement && overlay.classList.contains('is-open');

        const initCardMedia = (card) => {
          if (!(card instanceof HTMLElement)) return;
          if (mediaInitialized.has(card)) return;
          const media = card.querySelector('[data-media]');
          if (!(media instanceof HTMLElement)) return;
          const track = media.querySelector('[data-media-track]');
          if (!(track instanceof HTMLElement)) {
            mediaInitialized.add(card);
            return;
          }
          const slides = Array.from(track.querySelectorAll('[data-media-slide]'));
          if (slides.length === 0) {
            mediaInitialized.add(card);
            return;
          }
          const dots = Array.from(media.querySelectorAll('[data-media-dot]'));

          const applyVisibility = (current) => {
            slides.forEach((slide, index) => {
              const isActive = index === current;
              slide.setAttribute('data-active', isActive ? 'true' : 'false');
              slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
            });
            dots.forEach((dot, index) => {
              const isActive = index === current;
              dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
              dot.setAttribute('tabindex', isActive ? '0' : '-1');
              dot.classList.toggle('is-active', isActive);
            });
          };

          if (slides.length <= 1 || dots.length === 0) {
            applyVisibility(0);
            mediaInitialized.add(card);
            return;
          }

          let index = slides.findIndex((slide) => slide.getAttribute('data-active') === 'true');
          if (index < 0) index = 0;
          applyVisibility(index);

          const setActive = (nextIndex) => {
            const total = slides.length;
            index = ((nextIndex % total) + total) % total;
            applyVisibility(index);
          };

          dots.forEach((dot, dotIndex) => {
            if (!(dot instanceof HTMLButtonElement)) return;
            dot.addEventListener('click', () => setActive(dotIndex));
            dot.addEventListener('keydown', (event) => {
              if (event.key === 'ArrowRight') {
                event.preventDefault();
                setActive(index + 1);
              } else if (event.key === 'ArrowLeft') {
                event.preventDefault();
                setActive(index - 1);
              }
            });
          });

          if (card.classList.contains('project-card--overlay')) {
            media.addEventListener('click', (event) => {
              if (event.target instanceof HTMLElement && event.target.closest('[data-media-dot]')) {
                return;
              }
              setActive(index + 1);
            });
          }

          mediaInitialized.add(card);
        };

        const rafThrottle = (callback) => {
          let ticking = false;
          return (...args) => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              callback(...args);
            });
          };
        };

        const updateArrows = (carousel) => {
          const track = carousel.querySelector('[data-track]');
          if (!track) return;
          const maxScroll = track.scrollWidth - track.clientWidth - 1;
          const prev = carousel.querySelector('[data-dir="-1"]');
          const next = carousel.querySelector('[data-dir="1"]');
          if (prev instanceof HTMLButtonElement) {
            prev.disabled = track.scrollLeft <= 1;
          }
          if (next instanceof HTMLButtonElement) {
            next.disabled = maxScroll <= 1 || track.scrollLeft >= maxScroll;
          }
        };

        const closeOverlay = () => {
          if (!overlay) return;
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('project-overlay-open');
          if (overlayContent) {
            overlayContent.querySelectorAll('[data-media]').forEach((media) => {
              if (!(media instanceof HTMLElement)) return;
              media.querySelectorAll('[data-media-slide]').forEach((slide, index) => {
                slide.setAttribute('data-active', index === 0 ? 'true' : 'false');
                slide.setAttribute('aria-hidden', index === 0 ? 'false' : 'true');
              });
              media.querySelectorAll('[data-media-dot]').forEach((dot, index) => {
                if (!(dot instanceof HTMLElement)) return;
                dot.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
                dot.setAttribute('tabindex', index === 0 ? '0' : '-1');
                dot.classList.toggle('is-active', index === 0);
              });
            });
          }
          window.setTimeout(() => {
            overlay?.setAttribute('hidden', 'true');
            if (overlayContent) {
              overlayContent.innerHTML = '';
            }
          }, 220);
          if (lastFocusedElement instanceof HTMLElement) {
            lastFocusedElement.focus();
          }
          activeCardId = null;
        };

        const openOverlay = (card) => {
          if (!overlay || !overlayContent) return;
          const clone = card.cloneNode(true);
          clone.classList.add('project-card--overlay');
          clone.querySelectorAll('[data-project-body]').forEach((body) => {
            body.removeAttribute('data-project-body');
            body.setAttribute('aria-hidden', 'false');
            body.style.removeProperty('max-height');
          });
          overlayContent.innerHTML = '';
          overlayContent.appendChild(clone);
          initCardMedia(clone);
          overlay.removeAttribute('hidden');
          overlay.setAttribute('aria-hidden', 'false');
          overlay.classList.add('is-open');
          document.body.classList.add('project-overlay-open');
          const closeButton = overlayClose;
          if (closeButton instanceof HTMLElement) {
            closeButton.focus();
          }
        };

        const trapOverlayFocus = (event) => {
          if (event.key !== 'Tab') return;
          if (!isOverlayOpen() || !(overlay instanceof HTMLElement)) return;
          const focusables = Array.from(overlay.querySelectorAll(FOCUSABLE_SELECTOR)).filter(
            (element) =>
              element instanceof HTMLElement &&
              !element.hasAttribute('hidden') &&
              element.getAttribute('aria-hidden') !== 'true' &&
              (element.offsetParent !== null || element === document.activeElement),
          );
          if (focusables.length === 0) {
            event.preventDefault();
            return;
          }
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          const active = document.activeElement;
          if (event.shiftKey && active === first) {
            event.preventDefault();
            last.focus();
            return;
          }
          if (!event.shiftKey && active === last) {
            event.preventDefault();
            first.focus();
          }
        };

        const handleCardActivation = (card, trigger) => {
          lastFocusedElement = trigger ?? card;
          activeCardId = card.dataset.cardId ?? null;
          openOverlay(card);
        };

        const applyFilter = (carousel) => {
          const track = carousel.querySelector('[data-track]');
          if (!track) return;
          const cards = Array.from(track.querySelectorAll('[data-card]'));
          const hasFilters = activeFilters.size > 0;
          cards.forEach((card) => {
            const values = (card.dataset.tech ?? '').split(/\s+/).filter(Boolean);
            const matches = !hasFilters || values.some((value) => activeFilters.has(value));
            card.toggleAttribute('hidden', !matches);
            if (!matches && activeCardId && card.dataset.cardId === activeCardId) {
              closeOverlay();
            }
          });
          updateArrows(carousel);
        };

        const initCarousel = (carousel) => {
          const track = carousel.querySelector('[data-track]');
          if (!track) return;
          const cards = Array.from(track.querySelectorAll('[data-card]'));
          const buttons = Array.from(carousel.querySelectorAll('[data-dir]'));

          const getDistance = () => {
            const firstCard = track.querySelector('[data-card]:not([hidden])');
            const rect = firstCard?.getBoundingClientRect();
            const style = window.getComputedStyle(track);
            const gap = parseFloat(style.gap || '0');
            return (rect?.width ?? track.clientWidth) + gap;
          };

          buttons.forEach((btn) => {
            if (!(btn instanceof HTMLButtonElement)) return;
            const direction = Number(btn.getAttribute('data-dir') ?? '0');
            if (!direction) return;
            btn.addEventListener('click', () => {
              track.scrollBy({ left: direction * getDistance(), behavior: 'smooth' });
            });
          });

          const updateArrowsThrottled = rafThrottle(() => updateArrows(carousel));
          track.addEventListener('scroll', updateArrowsThrottled);
          window.addEventListener('resize', updateArrowsThrottled);

          cards.forEach((card) => {
            initCardMedia(card);
            let pointerStartX = 0;
            let pointerStartY = 0;
            let trackingPointer = false;
            let suppressClick = false;

            card.addEventListener('pointerdown', (event) => {
              if (event.pointerType === 'mouse' && event.button !== 0) return;
              trackingPointer = true;
              pointerStartX = event.clientX;
              pointerStartY = event.clientY;
              suppressClick = false;
            });

            card.addEventListener('pointermove', (event) => {
              if (!trackingPointer) return;
              const deltaX = Math.abs(event.clientX - pointerStartX);
              const deltaY = Math.abs(event.clientY - pointerStartY);
              if (deltaX > 12 || deltaY > 12) {
                suppressClick = true;
              }
            });

            const clearPointerState = () => {
              trackingPointer = false;
              if (suppressClick) {
                window.setTimeout(() => {
                  suppressClick = false;
                }, 0);
              }
            };

            card.addEventListener('pointerup', clearPointerState);
            card.addEventListener('pointercancel', clearPointerState);

            card.addEventListener('click', (event) => {
              if (suppressClick) return;
              const target = event.target;
              if (
                target instanceof HTMLElement &&
                target.closest('a, button, input, select, textarea, [contenteditable="true"]')
              ) {
                return;
              }
              handleCardActivation(card, card);
            });
            const detailsButtons = Array.from(card.querySelectorAll('[data-overlay-trigger]'));
            detailsButtons.forEach((button) => {
              if (!(button instanceof HTMLButtonElement)) return;
              button.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                handleCardActivation(card, button);
              });
              button.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                  event.preventDefault();
                  handleCardActivation(card, button);
                }
              });
            });
          });

          applyFilter(carousel);
          updateArrows(carousel);
        };

        if (overlayBackdrop instanceof HTMLElement) {
          overlayBackdrop.addEventListener('click', closeOverlay);
        }
        if (overlayClose instanceof HTMLElement) {
          overlayClose.addEventListener('click', closeOverlay);
        }
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            if (mobileLinksOpen) {
              closeMobileLinks();
              return;
            }
            if (isOverlayOpen()) {
              closeOverlay();
              return;
            }
          }
          trapOverlayFocus(event);
        });

        carousels.forEach(initCarousel);

        window.addEventListener('tech-filter-change', (event) => {
          activeFilters.clear();
          const values = Array.isArray(event.detail?.values) ? event.detail.values : [];
          values.forEach((value) => activeFilters.add(value));
          carousels.forEach(applyFilter);
        });
      })();
    </script>
  </body>
</html>

